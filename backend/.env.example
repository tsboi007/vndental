# BACKEND — chép file này thành backend/.env.local rồi điền mật khẩu. (Frontend: frontend/.env.example)
# Ký tự đặc biệt trong mật khẩu phải mã hóa URL (vd. @ -> %40).

# --- Local: container Docker "PhongKhamRangNCV" (cổng 5432) ---
# CSDL kiểm thử (npm run db:reset chỉ được trỏ vào CSDL này):
DATABASE_URL=postgres://Sang_admin:<mat-khau>@localhost:5432/PhongKhamRang_dev
# CSDL thật local:
# DATABASE_URL=postgres://Sang_admin:<mat-khau>@localhost:5432/PhongKhamRang

# --- Production: Neon (gói Free, Singapore), cấp qua tích hợp Neon trên Vercel ---
# Vercel tự đặt các biến này cho project "bevndental" — KHÔNG cần ghi vào đây.
# Xem / tải về (trong thư mục backend): vercel env ls  |  vercel env pull <file> --environment=production
# DATABASE_URL=postgresql://neondb_owner:<mat-khau>@<endpoint>-pooler.<vung>.aws.neon.tech/neondb?sslmode=require   (app, qua pooler)
# DATABASE_URL_UNPOOLED=postgresql://neondb_owner:<mat-khau>@<endpoint>.<vung>.aws.neon.tech/neondb?sslmode=require (scripts/db-init.mjs, pg_dump)

# --- Khóa ký token phiên đăng nhập (bắt buộc, >= 32 ký tự) ---
# Tạo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production đặt riêng trên Vercel (vercel env add SESSION_SECRET production --sensitive).
SESSION_SECRET=<chuoi-ngau-nhien>
